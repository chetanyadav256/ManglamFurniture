# Public browser configuration only. Never put secrets in VITE_* variables.
# In Vercel, set this to the Render backend origin (without /api), for example:
# VITE_API_BASE_URL=https://your-backend.onrender.com
# For local development, leave unset to use http://127.0.0.1:5000.
# The service appends /api; URLs already ending in /api are also supported.
VITE_API_BASE_URL=
