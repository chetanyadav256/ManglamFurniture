NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Required: MongoDB connection URI for the application database.
MONGODB_URI=

# Generate a private random secret of at least 32 bytes before starting the API.
# Keep this value in backend/.env; never use a frontend VITE_* variable.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Required when creating or managing images. Keep the API secret private.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# In production, set CLIENT_ORIGIN to the exact deployed frontend origin(s),
# comma-separated when more than one origin is required. Do not use *.
# Render binds to 0.0.0.0 by default in production; HOST is mainly for local use.
