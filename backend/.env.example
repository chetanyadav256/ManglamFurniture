NODE_ENV=development
HOST=127.0.0.1
PORT=5000
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Leave empty for the initial health-check-only setup.
# After starting MongoDB locally, use:
# MONGODB_URI=mongodb://127.0.0.1:27017/manglam_furniture
MONGODB_URI=

# Generate a private random secret of at least 32 bytes before starting the API.
# Keep this value in backend/.env; never use a frontend VITE_* variable.
JWT_SECRET=
JWT_EXPIRES_IN=1d
